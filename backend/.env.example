# ==============================================================================
# RecallOps Backend Environment Variables (TEMPLATE)
# Copy this file to backend/.env and populate with your real API credentials.
# ==============================================================================

# Groq Cloud API Key (https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Hindsight Memory Configuration (https://ui.hindsight.vectorize.io or local)
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_PROJECT_ID=recallops-demo
